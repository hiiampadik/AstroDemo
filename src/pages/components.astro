---
import Layout from '../layouts/Layout.astro';
import FancyBar from '../components/FancyBar.astro';
import Nav from '../components/Nav.astro';
import Tag from '../components/Tag.astro';
import Button from '../components/Button.astro';
import IconButton from '../components/IconButton.astro';
import ButtonGroup from '../components/ButtonGroup.astro';
import ExternalLinkIcon from '../components/icons/ExternalLinkIcon.astro';
import CodeIcon from '../components/icons/CodeIcon.astro';

const buttonVariants = [
  'filled',
  'outlined',
  'text',
  'text-compact',
  'text-compact-underline',
] as const;

const iconButtonVariants = ['filled', 'outlined', 'simple', 'compact'] as const;
---

<Layout title="Components — Atlas of Climate Change" fullWidth>
  <FancyBar />
  <Nav />

  <main class="page">
    <header class="page__head">
      <h1>Component library</h1>
      <p>
        Building blocks from the Figma file, implemented for the Atlas of
        Climate Change. Scroll to collapse the navigation; open the globe menu
        to see the language switcher. Hover / focus (Tab) the buttons for their
        interactive states.
      </p>
    </header>

    <!-- FancyBar + Nav -->
    <section class="section">
      <h2>FancyBar &amp; Navigation</h2>
      <p class="note">
        Both are fixed at the top of the page. The FancyBar (climate stripe)
        sits above the navigation. The nav shows the hero title on load and
        collapses to a compact bar on scroll.
      </p>
    </section>

    <!-- Tag -->
    <section class="section">
      <h2>Tag</h2>
      <div class="demo">
        <Tag label="Introduction" />
        <Tag label="The Science" />
        <Tag label="The Solutions" showIcon={false} />
      </div>
      <p class="note">Feed usage — tag followed by regular text:</p>
      <div class="demo demo--baseline">
        <span class="feed-example"><Tag label="Introduction" /> <span>The Big Picture</span></span>
      </div>
    </section>

    <!-- Button -->
    <section class="section">
      <h2>Button</h2>
      {
        buttonVariants.map((variant) => (
          <div class="matrix">
            <div class="matrix__name">{variant}</div>
            <div class="matrix__light">
              <Button variant={variant} tone="primary">Button</Button>
              <Button variant={variant} tone="secondary">Button</Button>
            </div>
            <div class="matrix__dark">
              <Button variant={variant} tone="inverse">Button</Button>
            </div>
          </div>
        ))
      }

      <h3>With icons &amp; disabled</h3>
      <div class="demo">
        <Button variant="filled" tone="primary">
          <ExternalLinkIcon slot="icon-left" size={16} />
          Open
        </Button>
        <Button variant="outlined" tone="primary">
          Read more
          <ExternalLinkIcon slot="icon-right" size={16} />
        </Button>
        <Button variant="filled" tone="primary" disabled>Disabled</Button>
        <Button variant="filled" tone="secondary" font="sans">Inter font</Button>
      </div>
    </section>

    <!-- IconButton -->
    <section class="section">
      <h2>IconButton</h2>
      {
        iconButtonVariants.map((variant) => (
          <div class="matrix">
            <div class="matrix__name">{variant}</div>
            <div class="matrix__light">
              <IconButton variant={variant} tone="primary" label="External link">
                <ExternalLinkIcon size={16} />
              </IconButton>
              <IconButton variant={variant} tone="secondary" label="Code">
                <CodeIcon size={16} />
              </IconButton>
            </div>
            <div class="matrix__dark">
              <IconButton variant={variant} tone="inverse" label="External link">
                <ExternalLinkIcon size={16} />
              </IconButton>
            </div>
          </div>
        ))
      }
    </section>

    <!-- ButtonGroup -->
    <section class="section">
      <h2>ButtonGroup</h2>
      <div class="demo demo--wrap">
        <ButtonGroup direction="row">
          <Button variant="text" tone="secondary">PDF</Button>
          <Button variant="text" tone="secondary">PNG</Button>
        </ButtonGroup>

        <ButtonGroup direction="row">
          <Button variant="text" tone="secondary">
            <ExternalLinkIcon slot="icon-left" size={16} />
            PDF
          </Button>
          <Button variant="text" tone="secondary">
            <CodeIcon slot="icon-left" size={16} />
            PNG
          </Button>
        </ButtonGroup>

        <ButtonGroup direction="row">
          <IconButton variant="simple" tone="secondary" label="External link">
            <ExternalLinkIcon size={16} />
          </IconButton>
          <IconButton variant="simple" tone="secondary" label="Code">
            <CodeIcon size={16} />
          </IconButton>
        </ButtonGroup>
      </div>

      <div class="demo">
        <ButtonGroup direction="column">
          <Button variant="text" tone="secondary">
            <ExternalLinkIcon slot="icon-left" size={16} />
            Naše tabulka s daty
          </Button>
          <Button variant="text" tone="secondary">
            <CodeIcon slot="icon-left" size={16} />
            Zdrojová data
          </Button>
        </ButtonGroup>
      </div>
    </section>

    <div class="spacer"></div>
  </main>
</Layout>

<style>
  .page {
    max-width: 1000px;
    margin-inline: auto;
    padding: 0 var(--size-6) var(--size-24);
    /* Clear the fixed FancyBar (20px) + hero nav on load. */
    padding-top: 260px;
    color: var(--text-primary);
  }

  .page__head h1 {
    font-family: var(--font-sans);
    font-size: 36px;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 var(--size-3);
  }
  .page__head p { max-width: 640px; color: var(--text-secondary); }

  .section {
    padding: var(--size-10) 0;
    border-top: 1px solid var(--gray-200);
  }
  .section h2 {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 var(--size-5);
  }
  .section h3 {
    font-family: var(--font-sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--text-secondary);
    margin: var(--size-8) 0 var(--size-3);
  }
  .note { color: var(--text-tertiary); margin: 0 0 var(--size-3); }

  .demo {
    display: flex;
    align-items: center;
    gap: var(--size-4);
  }
  .demo--wrap { flex-wrap: wrap; align-items: flex-start; }
  .demo--baseline { align-items: baseline; }

  .feed-example {
    display: inline-flex;
    align-items: center;
    gap: var(--size-2);
    font-family: var(--font-sans);
    font-size: 18px;
    color: var(--text-primary);
  }

  /* Variant matrix rows: name | light cell | dark cell */
  .matrix {
    display: grid;
    grid-template-columns: 200px 1fr auto;
    align-items: center;
    gap: var(--size-4);
    padding: var(--size-2) 0;
  }
  .matrix__name {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-tertiary);
  }
  .matrix__light,
  .matrix__dark {
    display: flex;
    align-items: center;
    gap: var(--size-3);
    padding: var(--size-3);
    border-radius: var(--size-2);
  }
  .matrix__light { background: var(--gray-50); }
  .matrix__dark { background: var(--blue-700); justify-content: center; }

  .spacer { height: 60vh; }
</style>
