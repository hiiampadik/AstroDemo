---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FancyBar from '../components/FancyBar.astro';
import Nav from '../components/Nav.astro';
import Tag from '../components/Tag.astro';
import ButtonGroup from '../components/ButtonGroup.astro';
import Button from '../components/Button.astro';
import RelatedCard from '../components/feed/RelatedCard.astro';
import ExternalLinkIcon from '../components/icons/ExternalLinkIcon.astro';
import CodeIcon from '../components/icons/CodeIcon.astro';
import { chapterName } from '../data/chapters';
import { getFlatInfographics } from '../data/infographics';
import { imgUrl } from '../utils/img';
import site from '../data/site.json';

export async function getStaticPaths() {
  const flat = await getFlatInfographics();
  const lookup = new Map(flat.map((f) => [f.slug, f]));

  const entries = await getCollection('infographics');
  const entryBySlug = new Map(entries.map((e) => [e.slug, e]));

  return flat.map((item, i) => {
    const entry = entryBySlug.get(item.slug)!;

    // Related: prefer the CMS relation list, else the next 2 (wrapping).
    const relatedSlugs =
      entry.data.related && entry.data.related.length
        ? entry.data.related
        : [flat[(i + 1) % flat.length].slug, flat[(i + 2) % flat.length].slug];
    const related = relatedSlugs
      .map((s) => lookup.get(s))
      .filter(Boolean)
      .map((r) => ({ slug: r!.slug, title: r!.title, image: r!.image }));

    return { params: { slug: item.slug }, props: { item, entry, related } };
  });
}

const { item, entry, related } = Astro.props;
const data = entry.data;
const { Content } = await entry.render();

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = data.title;
const lead = data.lead;
const chapterLabel = chapterName(data.chapter);
const imgSrc = imgUrl(data.image);

const pdfHref = data.downloads?.pdf || null;
const tableUrl = data.data?.tableUrl || '#';
const sourceUrl = data.data?.sourceUrl || '#';
const citation = data.data?.citation || '';

const href = (slug: string) => `${base}/${slug}/`;
---

<Layout title={`${title} — Atlas of Climate Change`} fullWidth>
  <FancyBar />
  <Nav compact menuLinks={site.menuLinks} siblings={site.languages} />

  <!-- Fixed split background (same as the feed). -->
  <div class="detail-bg" aria-hidden="true">
    <div class="detail-bg__fill detail-bg__fill--left"></div>
    <div class="detail-bg__center">
      <div class="detail-bg__col detail-bg__col--sidebar"></div>
      <div class="detail-bg__col detail-bg__col--content"></div>
    </div>
    <div class="detail-bg__fill detail-bg__fill--right"></div>
  </div>

  <div class="detail">
    <div class="detail__spacer"></div>

    <div class="detail__center">
      <div class="detail__main">
        <aside class="detail__sidebar-col">
          <div class="detail__sidebar-sticky">
            <div class="meta">
              <section class="meta__block">
                <h2 class="meta__label type-eyebrow">Download</h2>
                <ButtonGroup direction="row">
                  {pdfHref && (
                    <Button variant="text" tone="secondary" href={`${base}${pdfHref}`}>PDF</Button>
                  )}
                  <Button variant="text" tone="secondary" href={imgSrc}>PNG</Button>
                </ButtonGroup>
              </section>

              <section class="meta__block">
                <h2 class="meta__label type-eyebrow">Underlying data</h2>
                <div class="meta__data">
                  <ButtonGroup direction="column">
                    <Button variant="text" tone="secondary" href={tableUrl}>
                      <ExternalLinkIcon slot="icon-left" size={16} />
                      Our data table
                    </Button>
                    <Button variant="text" tone="secondary" href={sourceUrl}>
                      <CodeIcon slot="icon-left" size={16} />
                      Data source
                    </Button>
                  </ButtonGroup>
                  {citation && <p class="meta__source type-small">{citation}</p>}
                </div>
              </section>

              {related.length > 0 && (
                <section class="meta__block">
                  <h2 class="meta__label type-eyebrow">More articles</h2>
                  <div class="meta__related">
                    {related.map((r) => (
                      <RelatedCard title={r.title} image={r.image} href={href(r.slug)} />
                    ))}
                  </div>
                </section>
              )}
            </div>
          </div>
        </aside>

        <div class="detail__content">
          <div class="detail__hero">
            <div class="detail__hero-inner">
              <Tag label={chapterLabel} showIcon={false} />
              <div class="detail__titles">
                <h1 class="detail__title type-title">{title}</h1>
                <p class="detail__lead type-lead">{lead}</p>
              </div>
              <div class="detail__media">
                <img src={imgSrc} alt={title} />
              </div>
            </div>
          </div>

          <div class="detail__body">
            <div class="detail__prose">
              <Content />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="detail__spacer"></div>
  </div>
</Layout>

<style is:global>
  body { padding: 0; }
</style>

<style>
  .detail {
    --top-clear: 89px; /* FancyBar 20 + compact nav 69 */
    --sticky-top: 100px;
    position: relative;
    display: flex;
    align-items: stretch;
    /* clip (not hidden) so the hero's right bleed can't add a horizontal
       scrollbar, while keeping the sticky sidebar working */
    overflow-x: clip;
    overflow-y: visible;
  }

  /* Fixed split background */
  .detail-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: flex;
    pointer-events: none;
  }
  .detail-bg__fill { flex: 1 1 0; min-width: var(--size-4); }
  .detail-bg__fill--left { background: var(--blue-gray-200); }
  .detail-bg__fill--right { background: var(--blue-gray-100); }
  .detail-bg__center {
    flex: 0 1 1280px;
    min-width: 0;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
  }
  .detail-bg__col--sidebar { background: var(--blue-gray-200); }
  .detail-bg__col--content { background: var(--blue-gray-100); }

  .detail__spacer { flex: 1 1 0; min-width: var(--size-4); }

  .detail__center {
    position: relative;
    z-index: 1;
    flex: 0 1 1280px;
    min-width: 0;
    display: flex;
  }
  .detail__main {
    flex: 1;
    display: grid;
    grid-template-columns: 290px minmax(0, 1fr);
    min-width: 0;
  }

  /* Sidebar meta panel */
  .detail__sidebar-col {
    padding: calc(var(--top-clear) + 48px) var(--size-9) 0 0; /* right gap 36 */
    border-right: 1px solid var(--blue-gray-100);
  }
  .detail__sidebar-sticky {
    position: sticky;
    top: var(--sticky-top);
    /* Stay pinned while the content scrolls. Only if the panel itself is
       taller than the viewport does it scroll — and then only when the
       cursor is over it (that's where the scroll container lives). */
    max-height: calc(100vh - var(--sticky-top) - var(--size-6));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: var(--size-10); /* 40px */
    align-items: flex-start;
  }
  .meta__block {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* button groups hug, source/related stretch */
    gap: var(--size-4); /* 16px */
    width: 100%;
  }
  /* Left-align the content inside the sidebar buttons. */
  .meta :global(.btn) { justify-content: flex-start; }
  .meta__label {
    margin: 0;
    color: var(--text-primary);
  }
  .meta__data {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    gap: var(--size-2);
  }
  .meta__source {
    align-self: stretch;
    margin: 0;
    color: var(--text-tertiary);
  }
  .meta__related {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }

  /* Content */
  .detail__content { position: relative; min-width: 0; }

  .detail__hero {
    position: relative;
    z-index: 0;
    padding: calc(var(--top-clear) + 64px) 0 var(--size-16) var(--size-24); /* left 96, bottom 64 */
  }
  /* White band that bleeds to the right viewport edge (clipped by .detail). */
  .detail__hero::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 -100vw 0 0;
    background: var(--white);
  }
  .detail__hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* tag hugs its content instead of stretching */
    gap: var(--size-6); /* 24px */
    max-width: 894px;
  }
  .detail__titles {
    display: flex;
    flex-direction: column;
    gap: var(--size-2); /* 8px */
    width: 100%;
    margin-top: var(--size-2-5); /* small gap after tag (design 18) */
  }
  .detail__title {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__lead {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__media {
    width: 100%;
    aspect-ratio: 894 / 460;
    overflow: hidden;
    border-radius: var(--size-2);
  }
  .detail__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .detail__body {
    display: flex;
    flex-direction: column;
    gap: var(--size-12); /* 48px */
    padding: var(--size-16) 0 var(--size-24) var(--size-24); /* top 64, left 96, bottom 96 */
    max-width: 894px;
  }
  .detail__intro {
    margin: 0;
    color: var(--text-primary);
  }
  .detail__sections {
    display: flex;
    flex-direction: column;
    gap: var(--size-8); /* 32px */
    max-width: 600px;
  }
  .detail__section { display: flex; flex-direction: column; gap: var(--size-3); }
  .detail__section h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .detail__section p {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__section a {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
  }
  .detail__section a:hover { color: var(--blue-600); }

  /* Rendered markdown body (from the CMS). */
  .detail__prose { max-width: 600px; }
  .detail__prose :global(h2) {
    margin: var(--size-8) 0 var(--size-3);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.2;
    color: var(--text-primary);
  }
  .detail__prose :global(h2:first-child) { margin-top: 0; }
  .detail__prose :global(p) {
    margin: 0 0 var(--size-4);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__prose :global(ul),
  .detail__prose :global(ol) {
    margin: 0 0 var(--size-4);
    padding-left: var(--size-6);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    color: var(--text-primary);
  }
  .detail__prose :global(li) { margin-bottom: var(--size-2); }
  .detail__prose :global(a) {
    color: inherit;
    text-decoration: underline;
    text-underline-position: from-font;
  }
  .detail__prose :global(a:hover) { color: var(--blue-600); }
</style>
