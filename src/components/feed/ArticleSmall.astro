---
/**
 * ArticleSmall — grid-view card. Figma: Section/Grid → ArticleSmall (135:4558).
 * Title (16px Bold) above a cropped thumbnail (aspect ~16:9, border, radius 8).
 */
interface Props {
  title: string;
  image: string;
  slug: string;
  chapterId: string;
  href?: string;
}
const { title, image, slug, chapterId, href = '#' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = `${base}/images/atlas/${image}`;
---

<article class="scard" data-slug={slug} data-chapter={chapterId}>
  <a class="scard__link" href={href}>
    <h3 class="scard__title type-card-title">{title}</h3>
    <div class="scard__media">
      <img src={src} alt={title} loading="lazy" decoding="async" />
    </div>
  </a>
</article>

<style>
  .scard { scroll-margin-top: 110px; }
  .scard__link {
    display: flex;
    flex-direction: column;
    gap: var(--size-3-5); /* 14px */
    text-decoration: none;
  }
  .scard__title {
    margin: 0;
    color: var(--text-primary);
  }
  /* Aspect tuned to the atlas images (5906×4157) so a uniform scale crops
     3% off each side, 14% off the top, and leaves the bottom flush. */
  .scard__media {
    position: relative;
    width: 100%;
    aspect-ratio: 1.8;
    border: 1px solid var(--gray-300);
    border-radius: var(--size-2); /* 8px */
    overflow: hidden;
    background: var(--gray-100);
  }
  .scard__media img {
    position: absolute;
    left: -2%;
    bottom: -5%;
    width: 104%;
    height: auto; /* keep aspect ratio — no distortion */
    max-width: none;
    display: block;
  }
</style>
