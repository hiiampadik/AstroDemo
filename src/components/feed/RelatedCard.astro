---
/**
 * RelatedCard — small "More articles" card in the detail sidebar.
 * Figma: Side Nav buttons (233:7340). Thumbnail on top, title below;
 * blue-gray-100 fill, bordered, rounded.
 */
interface Props {
  title: string;
  image: string;
  href: string;
}
import { imgUrl } from '../../utils/img';
const { title, image, href } = Astro.props;
const src = imgUrl(image);
---

<a class="related" href={href}>
  <div class="related__media">
    <img src={src} alt={title} loading="lazy" decoding="async" />
  </div>
  <div class="related__title type-small-strong">{title}</div>
</a>

<style>
  .related {
    display: flex;
    flex-direction: column;
    background: var(--blue-gray-100);
    border: 1px solid var(--gray-300);
    border-radius: var(--size-1-5); /* 6px */
    overflow: hidden;
    text-decoration: none;
  }
  .related__media {
    aspect-ratio: 241 / 108;
    border-bottom: 1px solid var(--gray-300);
    overflow: hidden;
    background: var(--gray-100);
  }
  .related__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .related__title {
    padding: var(--size-2) var(--size-3); /* 8px 12px */
    color: var(--text-primary);
  }
  .related:hover .related__title { color: var(--blue-600); }
</style>
