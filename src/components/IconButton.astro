---
/**
 * IconButton — Figma node 81:1366. Square icon-only button.
 * Axes: variant (filled | outlined | simple | compact) × tone (primary | secondary | inverse).
 * filled/outlined/simple = 36×36 (24px icon, 6px padding); compact = 24×24.
 * `label` is required — it becomes the accessible name (aria-label + title).
 * Pass the icon via the default slot. Renders as <a> when `href` is set.
 */
type Variant = 'filled' | 'outlined' | 'simple' | 'compact';
type Tone = 'primary' | 'secondary' | 'inverse';

interface Props {
  label: string;
  variant?: Variant;
  tone?: Tone;
  href?: string;
  disabled?: boolean;
  class?: string;
}

const {
  label,
  variant = 'filled',
  tone = 'primary',
  href,
  disabled = false,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['iconbtn', `iconbtn--${variant}`, `iconbtn--${tone}`, className]}
  href={href}
  type={href ? undefined : 'button'}
  aria-label={label}
  title={label}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  <span class="iconbtn__icon"><slot /></span>
</Tag>

<style>
  .iconbtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-9); /* 36px */
    height: var(--size-9);
    padding: var(--size-1-5); /* 6px */
    border: 1px solid transparent;
    border-radius: var(--size-1-5); /* 6px */
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease,
      border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .iconbtn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--size-6); /* 24px */
    height: var(--size-6);
  }

  /* --- Filled --- */
  .iconbtn--filled.iconbtn--primary { background: var(--blue-600); color: var(--white); }
  .iconbtn--filled.iconbtn--primary:hover { background: var(--blue-700); }
  .iconbtn--filled.iconbtn--secondary { background: var(--gray-700); color: var(--white); }
  .iconbtn--filled.iconbtn--secondary:hover { background: var(--gray-800); }
  .iconbtn--filled.iconbtn--inverse { background: var(--white); color: var(--blue-600); }
  .iconbtn--filled.iconbtn--inverse:hover { background: var(--gray-50); }

  /* --- Outlined --- */
  .iconbtn--outlined.iconbtn--primary { border-color: var(--blue-600); color: var(--blue-600); }
  .iconbtn--outlined.iconbtn--primary:hover { background: var(--blue-50); }
  .iconbtn--outlined.iconbtn--secondary { border-color: var(--gray-700); color: var(--gray-700); }
  .iconbtn--outlined.iconbtn--secondary:hover { background: var(--gray-50); }
  .iconbtn--outlined.iconbtn--inverse { border-color: var(--white); color: var(--white); }
  .iconbtn--outlined.iconbtn--inverse:hover { background: rgba(255, 255, 255, 0.12); }

  /* --- Simple (no fill/border) --- */
  .iconbtn--simple.iconbtn--primary { color: var(--blue-600); }
  .iconbtn--simple.iconbtn--secondary { color: var(--text-primary); }
  .iconbtn--simple.iconbtn--inverse { color: var(--white); }

  /* --- Compact (24×24, no padding) --- */
  .iconbtn--compact {
    width: var(--size-6); /* 24px */
    height: var(--size-6);
    padding: 0;
    border: 0;
  }
  .iconbtn--compact.iconbtn--primary { color: var(--blue-600); }
  .iconbtn--compact.iconbtn--secondary { color: var(--text-primary); }
  .iconbtn--compact.iconbtn--inverse { color: var(--white); }

  /* --- Focus ring --- */
  .iconbtn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.35);
  }
  .iconbtn--secondary:focus-visible { box-shadow: 0 0 0 3px rgba(55, 65, 81, 0.35); }
  .iconbtn--inverse:focus-visible { box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5); }

  /* --- Disabled --- */
  .iconbtn:disabled,
  .iconbtn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
