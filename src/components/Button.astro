---
/**
 * Button — Figma node 81:1282.
 * Axes: variant (filled | outlined | text | text-compact | text-compact-underline)
 *        × tone (primary | secondary | inverse) × font (mono | sans).
 * States hover/focus come from CSS (:hover / :focus-visible), matching the
 * Figma Default/Hover/Focus variants. Renders as <a> when `href` is set.
 */
type Variant = 'filled' | 'outlined' | 'text' | 'text-compact' | 'text-compact-underline';
type Tone = 'primary' | 'secondary' | 'inverse';

interface Props {
  variant?: Variant;
  tone?: Tone;
  font?: 'mono' | 'sans';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'filled',
  tone = 'primary',
  font = 'mono',
  href,
  type = 'button',
  disabled = false,
  class: className,
} = Astro.props;

const Tag = href ? 'a' : 'button';
const hasIconLeft = Astro.slots.has('icon-left');
const hasIconRight = Astro.slots.has('icon-right');
---

<Tag
  class:list={['btn', `btn--${variant}`, `btn--${tone}`, `btn--font-${font}`, className]}
  href={href}
  type={href ? undefined : type}
  disabled={!href && disabled ? true : undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
>
  {hasIconLeft && <span class="btn__icon"><slot name="icon-left" /></span>}
  <span class="btn__label"><slot>Button</slot></span>
  {hasIconRight && <span class="btn__icon"><slot name="icon-right" /></span>}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--size-0-5); /* 2px */
    min-height: var(--size-9); /* 36px */
    padding: var(--size-1-5) var(--size-3); /* 6px 12px */
    border: 1px solid transparent;
    border-radius: var(--size-1-5); /* 6px */
    background: transparent;
    color: inherit;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 15px;
    line-height: normal;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease,
      border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .btn--font-sans { font-family: var(--font-sans); }
  .btn--font-mono { font-family: var(--font-mono); }

  .btn__label {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--size-1); /* 4px */
  }

  .btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: var(--size-6); /* 24px */
    height: var(--size-6);
  }

  /* --- Filled --- */
  .btn--filled.btn--primary { background: var(--blue-600); color: var(--white); }
  .btn--filled.btn--primary:hover { background: var(--blue-700); }
  .btn--filled.btn--secondary { background: var(--gray-700); color: var(--white); }
  .btn--filled.btn--secondary:hover { background: var(--gray-800); }
  .btn--filled.btn--inverse { background: var(--white); color: var(--blue-600); }
  .btn--filled.btn--inverse:hover { background: var(--gray-50); }

  /* --- Outlined --- */
  .btn--outlined { background: transparent; }
  .btn--outlined.btn--primary { border-color: var(--blue-600); color: var(--blue-600); }
  .btn--outlined.btn--primary:hover { background: var(--blue-50); }
  .btn--outlined.btn--secondary { border-color: var(--gray-700); color: var(--gray-700); }
  .btn--outlined.btn--secondary:hover { background: var(--gray-50); }
  .btn--outlined.btn--inverse { border-color: var(--white); color: var(--white); }
  .btn--outlined.btn--inverse:hover { background: rgba(255, 255, 255, 0.12); }

  /* --- Text (padded, no fill/border) --- */
  .btn--text.btn--primary { color: var(--blue-600); }
  .btn--text.btn--secondary { color: var(--text-primary); }
  .btn--text.btn--inverse { color: var(--white); }
  .btn--text:hover .btn__label { text-decoration: underline; }

  /* --- Text Compact / Text Compact Underline (inline, no padding/min-height) --- */
  .btn--text-compact,
  .btn--text-compact-underline {
    min-height: 0;
    padding: 0;
    border: 0;
    gap: var(--size-1-5); /* 6px */
  }
  .btn--text-compact .btn__label,
  .btn--text-compact-underline .btn__label { padding: 0; }
  .btn--text-compact.btn--primary,
  .btn--text-compact-underline.btn--primary { color: var(--blue-600); }
  .btn--text-compact.btn--secondary,
  .btn--text-compact-underline.btn--secondary { color: var(--text-primary); }
  .btn--text-compact.btn--inverse,
  .btn--text-compact-underline.btn--inverse { color: var(--white); }
  .btn--text-compact-underline .btn__label {
    text-decoration: underline;
    text-underline-position: from-font;
  }

  /* --- Focus ring (from Figma Focus state) --- */
  .btn:focus-visible {
    outline: none;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.35); /* blue-600 @ 35% */
  }
  .btn--secondary:focus-visible { box-shadow: 0 0 0 3px rgba(55, 65, 81, 0.35); }
  .btn--inverse:focus-visible { box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.5); }

  /* --- Disabled --- */
  .btn:disabled,
  .btn[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
