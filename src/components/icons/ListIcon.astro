---
interface Props {
  class?: string;
  size?: number;
}
const { class: className, size = 16 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path d="M3 6h18"></path>
  <path d="M3 12h18"></path>
  <path d="M3 18h18"></path>
</svg>
